# Server Port
PORT=5000

# MongoDB Connection String (Replace <username> and <password> with your Atlas cluster credentials)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.ixxneol.mongodb.net/food-rescue?retryWrites=true&w=majority&appName=Cluster0

# Optional: Email Transporter Settings for Feedback Receipts
# If left blank, Nodemailer automatically creates an Ethereal test inbox and prints preview URLs in the console.
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password
